# Copia este archivo como ".env" (en la misma carpeta ByteZone) y cambia los valores.
# Si no creas .env, el servidor usa valores de desarrollo y avisa en la consola.
PORT=3000
HOST=127.0.0.1
JWT_SECRET=cambia_esta_clave_por_una_frase_larga_y_secreta
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
